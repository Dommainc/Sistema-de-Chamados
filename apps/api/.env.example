# Copie para .env e preencha. Nunca commite valores reais (docs/segredos.md).

# dev = mostra "detalhe" nos erros e não muda o papel no login (o seed define); prod = nunca.
AMBIENTE=

# Conexão como o papel central_api. Na nuvem use a porta 6543 (Supavisor, modo transaction).
# Ex. local: postgresql://central_api:<senha>@127.0.0.1:54322/postgres
DATABASE_URL=

# URL do projeto Supabase (as chaves públicas do login vêm de {SUPABASE_URL}/auth/v1/.well-known/jwks.json).
SUPABASE_URL=
# Chave service_role: SÓ aqui na API (Storage/URLs assinadas). Nunca no front.
SUPABASE_SERVICE_ROLE_KEY=
# Só se o projeto ainda assina tokens com HS256 (projetos antigos / local). Senão, deixe vazio.
SUPABASE_JWT_SECRET=

# Id (GUID) do grupo "Central-Chamados-TI" no Entra ID (docs/adr/0004).
ENTRA_GRUPO_TI_ID=

# Origem do front liberada no CORS.
WEB_ORIGEM=http://localhost:3000

# Só para os testes de integração (tests/integracao): chave pública do Supabase.
SUPABASE_ANON_KEY=
