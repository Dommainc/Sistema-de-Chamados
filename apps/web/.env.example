# Copie para .env.local e preencha. Nunca commite valores reais (docs/segredos.md).

# Camada de dados (docs/adr/0006): "simulada" (dados de exemplo no navegador) ou "real".
# "simulada" é recusada no build de produção.
NEXT_PUBLIC_FONTE_DADOS=

# Só para a fonte "real" (depois da 1A-2):
# URL e chave pública (anon) do projeto Supabase. Nunca use a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL da FastAPI (ex.: http://localhost:8000)
NEXT_PUBLIC_API_URL=
# "true" mostra o login por e-mail/senha dos usuários de teste. Nunca em produção.
NEXT_PUBLIC_LOGIN_DEV=
